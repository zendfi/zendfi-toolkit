{
  "name": "@zendfi/sdk",
  "version": "1.1.5",
  "description": "Zero-config TypeScript SDK for ZendFi. Global payments powered by stablecoins!",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./nextjs": {
      "import": "./dist/nextjs.mjs",
      "require": "./dist/nextjs.js"
    },
    "./express": {
      "import": "./dist/express.mjs",
      "require": "./dist/express.js"
    },
    "./helpers": {
      "import": "./dist/helpers/index.mjs",
      "require": "./dist/helpers/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/nextjs.ts src/express.ts src/helpers/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/nextjs.ts src/express.ts src/helpers/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zendfi",
    "crypto",
    "payments",
    "solana",
    "sdk",
    "typescript"
  ],
  "author": "ZendFi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zendfi/zendfi-toolkit.git",
    "directory": "packages/sdk"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "cross-fetch": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.0",
    "next": "^14.0.0",
    "react": "^19.2.3",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
